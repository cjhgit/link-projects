{
  "name": "link-client",
  "version": "26.9.2600",
  "private": true,
  "description": "远程控制客户端：部署在云电脑（无公网 IP），主动连接服务端并执行指令",
  "scripts": {
    "dev": "tsx src/index.ts run",
    "dev:start": "tsx src/index.ts start",
    "dev:stop": "tsx src/index.ts stop",
    "build": "tsc",
    "start": "node dist/index.js start",
    "stop": "node dist/index.js stop",
    "restart": "node dist/index.js restart",
    "status": "node dist/index.js status"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
