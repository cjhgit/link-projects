# 服务端配置
# 推荐写到全局 ~/.link-projects/server.env（一处配置），
# 本文件仅作为项目级覆盖（优先级：环境变量 > 本文件 > 全局文件）。
# controller 连接专用 token，生成方式：openssl rand -hex 16
CONTROLLER_TOKEN=
# 监听端口（云服务器安全组需放行该端口）
PORT=9600
# wss（TLS 加密）监听端口：配置 TLS_CERT + TLS_KEY 后启用，与上面的 ws 端口并存
# 安全组需放行 TLS_PORT；client/controller 连 wss://<证书域名>:<TLS_PORT>
TLS_PORT=9601
# TLS 证书（含完整链）与私钥的路径，二者需同时配置
# TLS_CERT=/etc/link-certs/fullchain.crt
# TLS_KEY=/etc/link-certs/private.key
# client 白名单文件路径（clientId -> 专属 token），默认项目根目录 clients.json
# CLIENTS_FILE=/path/to/clients.json
